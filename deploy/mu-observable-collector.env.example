# ==============================================================================
# MuObservable Edge Telemetry Collector Configuration Environment
# Path: /etc/mu-observable-collector/collector.env
# Permissions: 0600 mu-observable-collector:mu-observable-collector
# ==============================================================================

# Logical node identifier attached to ingested records lacking node.id
MU_OBSERVABLE_COLLECTOR_NODE_ID=worker-node

# Bounded 256 MiB edge ring-buffer Write-Ahead Log path
MU_OBSERVABLE_COLLECTOR_WAL_PATH=/var/lib/mu-observable-collector/wal.duckdb

# Minimum free physical disk headroom (bytes) before strict FIFO WAL eviction triggers (512 MiB)
MU_OBSERVABLE_COLLECTOR_MIN_FREE_DISK_BYTES=536870912

# Loopback OTLP/HTTP ingestion listener address
MU_OBSERVABLE_COLLECTOR_OTLP_HTTP_ADDR=127.0.0.1:4318

# Loopback native MUOB Apache Arrow IPC TCP listener address
MU_OBSERVABLE_COLLECTOR_MUOB_TCP_ADDR=127.0.0.1:4319

# Optional upstream mu-observable-hub mTLS collector endpoint
# MU_OBSERVABLE_COLLECTOR_UPSTREAM_ADDR=hub.cluster.internal:9443

# Expected TLS server name (SAN) for upstream hub certificate verification
MU_OBSERVABLE_COLLECTOR_SERVER_NAME=node-a

# step-ca mutual TLS certificate bundle paths
MU_OBSERVABLE_COLLECTOR_TLS_CA=/etc/mu-observable-collector/tls/ca.crt
MU_OBSERVABLE_COLLECTOR_TLS_CERT=/etc/mu-observable-collector/tls/client.crt
MU_OBSERVABLE_COLLECTOR_TLS_KEY=/etc/mu-observable-collector/tls/client.key

# Optional comma-separated local log files to tail
# MU_OBSERVABLE_COLLECTOR_LOG_FILES=/var/log/syslog

# Enforce MuIsolation Landlock V3+ filesystem sandbox at startup on Linux
MU_OBSERVABLE_COLLECTOR_ENFORCE_LANDLOCK=false

# Tracing and logging level
RUST_LOG=info,mu_observable_collector=debug
